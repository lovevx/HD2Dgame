extends CharacterBody3D
## 玩家：俯视移动(继承原实现) + 战斗(三段连击/闪避/扇形攻击判定)

@export var move_speed: float = 5.0
@export var acceleration: float = 10.0
@export var friction: float = 8.0

# === 战斗参数 ===
@export var max_hp: float = 100.0
@export var attack_damage: float = 12.0
@export var attack_range: float = 2.2
@export var attack_arc_half: float = 1.0          # 攻击扇区半角(弧度)，整锥约 114°
@export var combo_window: float = 0.4             # 连段续接窗口(秒)
@export var base_attack_cooldown: float = 0.42    # 攻击出手间隔
# 闪避
@export var dodge_speed: float = 15.0
@export var dodge_duration: float = 0.2
@export var dodge_cooldown: float = 0.6

# === 运行时状态 ===
var hp: float
var alive: bool = true
var invulnerable: bool = false    # 闪避无敌帧
var input_dir := Vector2.ZERO
var facing := Vector3(0, 0, -1)

# 攻击
var combo_stage: int = -1
var combo_timer: float = 0.0
var attack_cd: float = 0.0
# 闪避
var dodging: bool = false
var dodge_timer: float = 0.0
var dodge_cd: float = 0.0
var dodge_dir := Vector3.ZERO

signal hp_changed(current: float, maximum: float)
signal attacked(stage: int)
signal hit_target(target: Node, dmg: float)
signal died

func _ready() -> void:
	hp = max_hp
	add_to_group("player")

func reset() -> void:
	hp = max_hp
	alive = true
	invulnerable = false
	combo_stage = -1
	hp_changed.emit(hp, max_hp)

func _physics_process(delta: float) -> void:
	# 1. 输入方向
	input_dir = Vector2.ZERO
	if Input.is_action_pressed("move_up"):
		input_dir.y -= 1
	if Input.is_action_pressed("move_down"):
		input_dir.y += 1
	if Input.is_action_pressed("move_left"):
		input_dir.x -= 1
	if Input.is_action_pressed("move_right"):
		input_dir.x += 1
	input_dir = input_dir.limit_length(1.0)
	if input_dir != Vector2.ZERO and not dodging:
		facing = Vector3(input_dir.x, 0, input_dir.y).normalized()

	# 2. 计时器
	attack_cd = maxf(0.0, attack_cd - delta)
	dodge_cd = maxf(0.0, dodge_cd - delta)
	combo_timer = maxf(0.0, combo_timer - delta)
	if combo_timer == 0.0:
		combo_stage = -1

	# 3. 触发
	if Input.is_action_just_pressed("dodge") and not dodging and dodge_cd <= 0.0:
		_start_dodge()
	if Input.is_action_just_pressed("attack") and not dodging and attack_cd <= 0.0:
		_do_attack()

	# 4. 移动
	var target_velocity := Vector3.ZERO
	if dodging:
		target_velocity = dodge_dir * dodge_speed
	else:
		target_velocity = Vector3(input_dir.x, 0, input_dir.y) * move_speed
	velocity.x = lerpf(velocity.x, target_velocity.x, acceleration * delta)
	velocity.z = lerpf(velocity.z, target_velocity.z, acceleration * delta)
	if not dodging and input_dir == Vector2.ZERO:
		velocity.x = lerpf(velocity.x, 0.0, friction * delta)
		velocity.z = lerpf(velocity.z, 0.0, friction * delta)
	if not is_on_floor():
		velocity.y -= 20.0 * delta
	move_and_slide()
	position.y = 0.0

func _start_dodge() -> void:
	dodging = true
	dodge_timer = dodge_duration
	dodge_cd = dodge_cooldown
	invulnerable = true
	if input_dir != Vector2.ZERO:
		dodge_dir = Vector3(input_dir.x, 0, input_dir.y).normalized()
	else:
		dodge_dir = facing
	get_tree().create_timer(dodge_duration).timeout.connect(_end_dodge)

func _end_dodge() -> void:
	dodging = false
	invulnerable = false

func _do_attack() -> void:
	attack_cd = base_attack_cooldown
	# 连段推进: 0→1→2→回到0(新一组)；超时后从0开始
	if combo_timer <= 0.0:
		combo_stage = 0
	else:
		combo_stage = (combo_stage + 1) % 3
	combo_timer = combo_window

	var mult: float = [1.0, 1.15, 1.8][combo_stage]
	var range: float = attack_range + 0.3 * combo_stage
	attacked.emit(combo_stage)
	# 轻微前冲提升手感
	velocity += facing * 1.8
	# 扇形命中判定(单帧扫描)
	_hurt_in_cone(range, attack_damage * mult)

func _hurt_in_cone(range: float, dmg: float) -> void:
	for e in get_tree().get_nodes_in_group("enemies"):
		if not e is CharacterBody3D:
			continue
		if e.has_method("is_alive") and not e.is_alive():
			continue
		var to: Vector3 = e.global_position - global_position
		to.y = 0.0
		var dist: float = to.length()
		if dist > range or dist < 0.2:
			continue
		var dot: float = to.normalized().dot(facing)
		if dot < cos(attack_arc_half):
			continue
		if e.has_method("take_damage"):
			e.take_damage(dmg, facing * 6.0, self)
		hit_target.emit(e, dmg)

func take_damage(amount: float, _from_dir := Vector3.ZERO) -> void:
	if not alive or invulnerable:
		return
	hp = maxf(0.0, hp - amount)
	hp_changed.emit(hp, max_hp)
	if hp <= 0.0:
		_die()

func _die() -> void:
	alive = false
	died.emit()
